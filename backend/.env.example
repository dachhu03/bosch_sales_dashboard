# Backend Environment Configuration (Express / Node.js)
# Copy to .env for local runtime

# Server Port
PORT=5000

# Active Runtime Environment (development / production)
NODE_ENV=development

# Allowed CORS Frontend Origin (Production: https://bosch-sales-dashboard.vercel.app)
FRONTEND_URL=http://localhost:5173

# Supabase & JWT Authentication Secrets
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key
JWT_SECRET=your-secure-jwt-secret-key
