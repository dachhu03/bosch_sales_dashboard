# Backend Environment Configuration (Express / Node.js)
# Copy to .env for local runtime

# Server Port
PORT=5000

# Active Runtime Environment (development / production)
NODE_ENV=development

# Allowed CORS Frontend Origin (Production: https://bosch-sales-dashboard.vercel.app)
FRONTEND_URL=http://localhost:5173

# Supabase & JWT Authentication Secrets
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key
JWT_SECRET=your-secure-jwt-secret-key

# HTTP REST API Email Configuration (Recommended for Render / Cloud hosting)
# Option A: Resend API (https://resend.com - 3000 free emails/month)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=Bosch Sales Dashboard <onboarding@resend.dev>

# Option B: Brevo API (https://brevo.com - 300 free emails/day)
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# SMTP Nodemailer Gmail Configuration (Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
EMAIL_FROM=Bosch Sales Dashboard <your-email@gmail.com>
APP_URL=http://localhost:5173
